# ClearHire Backend Configuration Template
# Copy this file to .env and configure for your environment

# Application Mode
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ClearHire API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Select backend: "hana" (SAP HANA Cloud) or "sqlite" (Local Development Default)
DATABASE_BACKEND=hana

# OPTION A: SAP HANA Cloud Configuration
HANA_HOST=64e8c26b-3e07-47e9-b246-617058b0306e.hna3.prod-eu10.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=Hackfest0328
HANA_PASSWORD=YourHanaPasswordHere
HANA_SCHEMA=HACKFEST0328
HANA_ENCRYPT=true
HANA_SSL_VALIDATE_CERTIFICATE=true
HANA_POOL_SIZE=10
HANA_MAX_OVERFLOW=15
HANA_POOL_RECYCLE=300
HANA_POOL_TIMEOUT=15

# OPTION B: SQLite (Zero configuration needed, recommended for offline development)
# DATABASE_BACKEND=sqlite
# DATABASE_URL=sqlite+aiosqlite:///./clearhire.db

# OPTION C: PostgreSQL (If running local Postgres container)
# DATABASE_BACKEND=postgres
# POSTGRES_USER=clearhire_user
# POSTGRES_PASSWORD=clearhire_secure_dev_password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=clearhire_db

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT)
# ==============================================================================
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=8

# ==============================================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================================
# Options: fake, openai, anthropic, gemini
LLM_PROVIDER=fake
LLM_API_KEY=placeholder_api_key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Document Processing & Storage
OCR_PROVIDER=auto
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=30

# Background Worker
WORKER_BACKEND=local
WORKER_CONCURRENCY=2
