# ClearHire Backend Configuration Template
# Copy this file to .env and adjust variables for your local setup

# Application
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ClearHire API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# Database Configuration (PostgreSQL)
POSTGRES_USER=clearhire_user
POSTGRES_PASSWORD=clearhire_secure_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clearhire_db
# Full async connection string: postgresql+asyncpg://{USER}:{PASSWORD}@{HOST}:{PORT}/{DB}
# DATABASE_URL=postgresql+asyncpg://clearhire_user:clearhire_secure_dev_password@localhost:5432/clearhire_db

# Security & Authentication (JWT)
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider Configuration
# Options: fake, openai, anthropic, gemini
LLM_PROVIDER=fake
LLM_API_KEY=placeholder_api_key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Document Processing & Storage
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=15

# Background Worker
WORKER_CONCURRENCY=2
