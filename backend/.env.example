# ClearHire Backend Configuration Template (Main Branch - Local / SQLite / PostgreSQL)
# Copy this file to .env and adjust variables for your local setup

# Application Mode
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ClearHire API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Option A: SQLite (Default - Zero configuration required for instant local development)
DATABASE_URL=sqlite+aiosqlite:///./clearhire.db

# Option B: PostgreSQL (Uncomment and configure if using PostgreSQL)
# POSTGRES_USER=clearhire_user
# POSTGRES_PASSWORD=clearhire_secure_dev_password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=clearhire_db
# POSTGRES_POOL_SIZE=15
# POSTGRES_MAX_OVERFLOW=25
# POSTGRES_POOL_RECYCLE=300
# POSTGRES_POOL_TIMEOUT=10
# Full async connection string: postgresql+asyncpg://{USER}:{PASSWORD}@{HOST}:{PORT}/{DB}

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT)
# ==============================================================================
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=8

# ==============================================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================================
# Options: fake, openai, anthropic, gemini
LLM_PROVIDER=fake
LLM_API_KEY=placeholder_api_key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Document Processing & Storage
OCR_PROVIDER=auto
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=30

# Background Worker
WORKER_BACKEND=local
WORKER_CONCURRENCY=2
